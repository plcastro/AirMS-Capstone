# MOBILE - generated/local files
# ==================================================
mobile/.expo/
mobile/dist/
mobile/dist-*/
mobile/web-build/
mobile/.kotlin/

# Native folders generated by Expo Prebuild / CNG
mobile/android/
mobile/ios/

# Firebase files generated during EAS Build
mobile/google-services.json
mobile/GoogleService-Info.plist

# ==================================================
