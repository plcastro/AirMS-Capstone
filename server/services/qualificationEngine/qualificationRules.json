{
  "version": "1.1.0",
  "ruleCode": "VERIFIED_AIRCRAFT_CERTIFICATE_ALL_TASKS",
  "description": "A verified, valid certificate covering an aircraft model grants all AirMS tasks on that model to a mechanic. The approved AirMS policy groups AS350B3 and AS350B3e under AS350B3.",
  "personnelRole": "mechanic",
  "taskScope": "ALL_TASKS",
  "aircraft": ["AS350B3", "B412EP"],
  "expiryDateInclusive": true,
  "requirements": [
    "CERTIFICATE_ID",
    "PERSONNEL_MATCH",
    "VERIFIED",
    "REVIEW_EVIDENCE",
    "NOT_REVOKED",
    "ISSUE_DATE",
    "EXPIRY_DATE",
    "DATE_ORDER",
    "AIRCRAFT_RATINGS",
    "KNOWN_AIRCRAFT",
    "NO_LIMITATIONS",
    "REVIEW_RESOLVED",
    "UNIQUE_SOURCE"
  ]
}
